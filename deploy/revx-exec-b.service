[Unit]
Description=Revolut X micro-live BOT B (REAL orders) — третья точка лестницы отступа, 16 б.п.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/revx-exec-b
EnvironmentFile=/etc/revx-exec-b.env

# Профиль B — ТРЕТЬЯ ТОЧКА ЛЕСТНИЦЫ ОТСТУПА (с 02.09.2026).
#
# Чем был раньше: носителем механизмов (пол по себестоимости + поводок) против
# бота A. Эту роль он отработал, и она закончилась: ВСЕ три механизма, которые
# живой бот вообще умеет включать, измерены и закрыты —
#   пол            вреден на трёх окнах, на падении в семь раз (док. 139 §4);
#   поводок        вреден на трёх окнах (доки 136 §4, 139 §6);
#   растущий шаг   вреден монотонно (доки 136 §6, 139 §8).
# Липкость и заморозка в исполнителе зашиты выключенными, конфигом их не поднять.
# Держать бота на подтверждении уже вынесенного приговора — тратить единственный
# дефицитный ресурс (постановки и время) впустую.
#
# Чем стал: третьей точкой для измерения κ на ЖИВЫХ данных. Интенсивность
# λ(δ) = A·e^{−κδ} и всё, что из неё следует — рабочая точка δ* = c + 1/κ и
# ранжирование пар, — держатся на κ, которая живьём не мерилась ни разу
# (док. 132 §5). Двумя точками (A на 10, C на 14) меряется только наклон;
# третья впервые позволяет проверить саму ФОРМУ закона, а толстый хвост
# подозревал ещё док. 103 §4.
#
# Почему 16, а не 12 и не 20. Точность наклона ∝ Σ wᵢ(δᵢ − δ̄)², вес — число
# исполнений. По живым частотам (A 9.1/ч на 10 б.п., C 1.8/ч на 14 б.п. →
# 1/κ ≈ 2.5 б.п.) кандидаты дают: 12 → 702, 16 → 1080, 18 → 1017, 20 → 899.
# Двенадцать ложатся ВНУТРЬ имеющегося интервала и почти не добавляют
# информации; на двадцати точка не набирает статистики (3.8 исполнения в сутки).
#
# Механизмы выключены ЯВНО, а не умолчанием: умолчание меняется правкой конфига,
# и точка лестницы однажды перестанет быть точкой лестницы молча.
ExecStart=/home/ubuntu/jre25/bin/java -Xms32m -Xmx192m -jar /home/ubuntu/revx-exec-b/app.jar --revx-exec \
  --revx.exec.bot-id=b \
  --revx.exec.journal=state/exec-b.db \
  --revx.exec.offset=0.0016 \
  --revx.exec.skew-target=0.3 \
  --revx.exec.cost-floor-margin=-1 \
  --revx.exec.anchor-leash=-1 \
  --revx.exec.own-position=true \
  --revx.exec.position-seed=0 \
  --revx.exec.park-distance=0.10

# Добивает ТОЛЬКО свои заявки: panic-all по умолчанию false, иначе остановка
# бота B снимала бы живые заявки бота A.
ExecStopPost=/bin/bash -c '/home/ubuntu/jre25/bin/java -Xmx192m -jar /home/ubuntu/revx-exec-b/app.jar --revx-panic --revx.exec.bot-id=b --revx.exec.journal=state/exec-b.db || true'

# Намеренно НЕТ автоперезапуска: перезапуск после падения не должен сам
# возобновлять торговлю. Котирование в любом случае стартует выключенным.
# Нормальная остановка через SIGTERM даёт код 143. Без этой строки systemd
# показывает «failed» после каждого штатного stop, и настоящую аварию в этом шуме
# уже не заметить. У бота A она была с самого начала, у B — нет, и остановка
# 02.09.2026 честно отработала панику, но осталась в статусе «failed».
SuccessExitStatus=143

Restart=no
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
