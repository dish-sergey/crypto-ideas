[Unit]
Description=Revolut X micro-live BOT B (REAL orders) — SOL/USDC, первая пара кроме биткойна
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/revx-exec-b
EnvironmentFile=/etc/revx-exec-b.env

# Профиль B — SOL/USDC (с 05.09.2026).
#
# Чем был раньше: сначала носителем механизмов против бота A, потом третьей
# точкой лестницы отступа на BTC (16 б.п. против 10 у A и 14 у C).
#
# Обе роли закончились. Механизмы измерены и закрыты все три (пол, поводок,
# растущий шаг — доки 136, 139). Точка лестницы своё отработала: κ на живых
# данных теперь меряется, а держать третьего бота на биткойне дальше значит
# тратить дефицитный ресурс на пару, которая по стенду ХУДШАЯ из трёх —
# BTC 0.3% годовых на капитал против 13.7% у SOL (док. 149 §10 с поправкой
# док. 151 §2).
#
# Чем стал: ПЕРВОЙ парой кроме биткойна на живых деньгах.
#
# Почему именно SOL. По доходу на капитал она первая из измеренных (13.7%
# против 6.8% у ETH и 0.3% у BTC). По доходу на единицу РИСКА первый, наоборот,
# BTC (0.1374 против 0.0478 у ETH, док. 149 §6) — то есть это не «лучшая пара
# вообще», а лучшая по одному из двух знаменателей, и живое измерение нужно
# именно чтобы понять, какой из них решает.
#
# ⚠️ Чего живое НЕ проверит: у SOL закон прихода перестаёт держаться с лота
# $100 (R² 0.895 при пороге 0.9, док. 145 §5). Мы стоим на лоте $1, где он
# держится (R² 0.915), поэтому запуск законен — но переносить результат на
# торговый размер нельзя, это отдельный незакрытый вопрос.
#
# Параметры под живой масштаб (цена SOL 101.5 на 04.09.2026):
#   лот $1        → size 0.009851 SOL, это 9851 шагов количества (шаг 1e-6)
#   потолок 20 лотов → cap 0.197011 SOL ≈ $20, как у остальных ботов
#   минимум заявки 0.1 USDC → запас десятикратный
#
# Отступ 13 б.п., а не измеренные ранее 14.76. δ* = c + 1/κ, и пошлина c упала:
# SOL переведён на СЕКУНДНЫЙ опрос (док. 151 §4), устаревание 2.86 → 1.28 б.п.
# Полуспред пары при этом 21.5 б.п. — стоим заметно внутри книги.
#
# Механизмы выключены ЯВНО, а не умолчанием: умолчание меняется правкой конфига,
# и профиль однажды перестанет быть тем, чем задуман, молча.
ExecStart=/home/ubuntu/jre25/bin/java -Xms32m -Xmx192m -jar /home/ubuntu/revx-exec-b/app.jar --revx-exec \
  --revx.exec.bot-id=b \
  --revx.exec.symbol=SOL/USDC \
  --revx.exec.journal=state/exec-b-sol.db \
  --revx.exec.size=0.009851 \
  --revx.exec.inventory-cap=0.197011 \
  --revx.exec.offset=0.0013 \
  --revx.exec.skew-target=0.3 \
  --revx.exec.cost-floor-margin=-1 \
  --revx.exec.anchor-leash=-1 \
  --revx.exec.own-position=true \
  --revx.exec.position-seed=0 \
  --revx.exec.park-distance=0.10

# ⚠️ ЖУРНАЛ НОВЫЙ (exec-b-sol.db), а не прежний exec-b.db. Смешивать в одной
# книге партий сделки по BTC и по SOL нельзя: FIFO сложил бы разные монеты в
# одну позицию, и P&L перестал бы что-либо значить. Старый журнал остаётся на
# месте как история BTC-периода.

# Добивает ТОЛЬКО свои заявки: panic-all по умолчанию false, иначе остановка
# бота B снимала бы живые заявки бота A.
ExecStopPost=/bin/bash -c '/home/ubuntu/jre25/bin/java -Xmx192m -jar /home/ubuntu/revx-exec-b/app.jar --revx-panic --revx.exec.bot-id=b --revx.exec.symbol=SOL/USDC --revx.exec.journal=state/exec-b-sol.db || true'

# Намеренно НЕТ автоперезапуска: перезапуск после падения не должен сам
# возобновлять торговлю. Котирование в любом случае стартует выключенным.
# Нормальная остановка через SIGTERM даёт код 143. Без этой строки systemd
# показывает «failed» после каждого штатного stop, и настоящую аварию в этом шуме
# уже не заметить.
SuccessExitStatus=143

Restart=no
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
