[Unit]
Description=Revolut X micro-live BOT B (REAL orders) — SOL/USDC
After=network-online.target revx-collect.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/revx-exec-b
EnvironmentFile=/etc/revx-exec-b.env

# Профиль B — SOL/USDC, ПЕРВАЯ по доходу пара обхода вселенной (06.09.2026).
#
# +4.9675 USDC за 16 суток при отступе 18 б.п. — лучший результат из двадцати
# трёх пар. Расход 134 постановки в сутки при доле 200.
#
# Лестница отступов пройдена насквозь и вершина НАСТОЯЩАЯ, а не край перебора:
#   6 → +3.6657   12 → +4.4018   16 → +4.7443   20 → +4.9013
#   8 → +3.9702   14 → +4.5590   18 → +4.9675  <- вершина
#
# Прежде B стоял на 10 б.п. (док. 151). Расширение до 18 добавляет 13% дохода
# и снижает расход постановок со 175 до 134 — редкий случай, когда обе величины
# улучшаются разом.
#
# ⚠️ ЧТО ИМЕННО ЗДЕСЬ ХОРОШО, а что нет.
#
# Хорошо: волатильность окна для SOL была НОРМАЛЬНОЙ — дней с движением ≥3%
# 43.8% против базовых 38.2% за два года, среднее движение 3.11% против 2.93%.
# То есть первое место не куплено разгулом рынка.
#
# Плохо: 16-дневная доходность SOL за окно +19.4% — это 91-й перцентиль всех
# двухнедельных отрезков за два года при обычных +0.5%. Абсолютный уровень
# дохода завышен направлением рынка, потому что «реализовано» не включает
# непроданный остаток.
#
# Умеренно: выброс двух крайних суток снижает доход на 10% (+0.3105 → +0.2789).
# Меньше, чем у ADA (−31%) и PEPE (−20%), больше, чем у BTC и ETH (там +4%).
#
# ⚠️ Контроль повтора на боте B даёт 72.6% совпавших котировок против 99.92% у
# A. Причина не разобрана. Это относится к сверке симуляции с живым, а не к
# самой торговле, но доверие к числам по SOL ниже, чем к биткойновым.
ExecStart=/home/ubuntu/jre25/bin/java -Xms32m -Xmx192m -jar /home/ubuntu/revx-exec-b/app.jar --revx-exec \
  --revx.exec.bot-id=b \
  --revx.exec.symbol=SOL/USDC \
  --revx.exec.journal=state/exec-b-sol.db \
  --revx.exec.size=0.009440 \
  --revx.exec.inventory-cap=0.188801 \
  --revx.exec.offset=0.0018 \
  --revx.exec.skew-target=0.3 \
  --revx.exec.cost-floor-margin=-1 \
  --revx.exec.anchor-leash=-1 \
  --revx.exec.own-position=true \
  --revx.exec.position-seed=0 \
  --revx.exec.park-distance=0.10 \
  --revx.exec.levels=3 \
  --revx.exec.level-step=0.0002 \
  --revx.exec.inner-first=false

# Размеры под цену SOL 105.932 на 06.09.2026: лот $1 = 0.009440 SOL, потолок
# $20 = 0.188801 SOL. Шаг количества 1e-06, шаг цены 0.001 = 0.094 б.п.
#
# ⚠️ Журнал ПРЕЖНИЙ (state/exec-b-sol.db): пара не менялась с 05.09.2026.
# Старый exec-b.db остаётся на месте как история BTC-периода — смешивать в
# одной книге партий сделки по BTC и по SOL нельзя, FIFO сложил бы разные
# монеты в одну позицию.

ExecStopPost=/bin/bash -c '/home/ubuntu/jre25/bin/java -Xmx192m -jar /home/ubuntu/revx-exec-b/app.jar --revx-panic --revx.exec.bot-id=b --revx.exec.symbol=SOL/USDC --revx.exec.journal=state/exec-b-sol.db || true'

SuccessExitStatus=143
Restart=no
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
