[Unit]
Description=Revolut X micro-live BOT C (REAL orders) — ETH/USDC
After=network-online.target revx-collect.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/revx-exec-c
EnvironmentFile=/etc/revx-exec-c.env

# Профиль C — ETH/USDC, ЧЕТВЁРТАЯ по доходу пара обхода вселенной (06.09.2026).
#
# +3.1910 USDC за 16 суток при отступе 14 б.п., расход 130 постановок в сутки.
# Лестница: 12 → +3.1245, 14 → +3.1910, 16 → +3.1876, 18 → +3.0791,
# 20 → +2.8802. Вершина внутри перебора, плато 12-16 широкое.
#
# ⚠️ ЭТО САМОЕ НАДЁЖНОЕ ЧИСЛО ВО ВСЁМ НАБОРЕ, и вот почему.
#
# Окно измерения для эфира оказалось РЕПРЕЗЕНТАТИВНЫМ по обоим признакам:
#   волатильность: среднее движение 2.44% против базовых 2.52% за два года
#                  (отношение 0.97 — окно даже спокойнее нормы);
#   направление:   16-дневная доходность +9.0%, это 75-й перцентиль, тогда как
#                  у SOL 91-й, а у BTC 94-й.
# Плюс устойчивость: выброс двух крайних суток доход не ухудшает (+4%).
#
# У остальных пяти хотя бы один из этих признаков плох. Поэтому если живое
# разойдётся с прогнозом, разбираться надо начиная с эфира: здесь расхождение
# нельзя будет списать на щедрое окно.
#
# Чем C был раньше: третьей точкой лестницы отступа на BTC (14 б.п. против 10
# у A). Роль закончилась — κ на живых данных теперь меряется, а держать третьего
# бота на биткойне при шести парах значит тратить дефицитный ресурс на худшую
# по доходу на постановку пару набора.
ExecStart=/home/ubuntu/jre25/bin/java -Xms32m -Xmx192m -jar /home/ubuntu/revx-exec-c/app.jar --revx-exec \
  --revx.exec.bot-id=c \
  --revx.exec.symbol=ETH/USDC \
  --revx.exec.journal=state/exec-c-eth.db \
  --revx.exec.size=0.00120795 \
  --revx.exec.inventory-cap=0.00845565 \
  --revx.exec.offset=0.0018 \
  --revx.exec.skew-target=0.3 \
  --revx.exec.cost-floor-margin=-1 \
  --revx.exec.anchor-leash=-1 \
  --revx.exec.own-position=true \
  --revx.exec.position-seed=0 \
  --revx.exec.park-distance=0.10 \
  --revx.exec.levels=1 \
  --revx.exec.level-step=0.0002 \
  --revx.exec.inner-first=false

# Размеры под цену ETH 2483.525 на 06.09.2026: лот $1 = 0.00040265 ETH,
# потолок $20 = 0.00805307 ETH. Шаг количества 1e-08, шаг цены 0.01 = 0.04 б.п.
#
# ⚠️ ЖУРНАЛ НОВЫЙ (exec-c-eth.db), а не прежний exec-c.db. Бот сменил пару с
# BTC на ETH, и смешивать в одной книге партий сделки по разным монетам нельзя:
# FIFO сложил бы их в одну позицию, и P&L перестал бы что-либо значить. Старый
# журнал остаётся на месте как история BTC-периода.

# ПЛАНОВАЯ остановка ПАРКУЕТ заявки, а не снимает их: восстановление после# отмены стоит 3-6 постановок (замер 07.09.2026), а оставленную заявку# вернувшийся бот усыновляет по метке и двигает через PUT — бесплатно.# ⚠️ Аварийная остановка по-прежнему снимает всё: --revx-panic на кнопке в боте# и на ручном запуске (ТЗ §6). Трогает ТОЛЬКО свои заявки.
ExecStopPost=/bin/bash -c '/home/ubuntu/jre25/bin/java -Xmx192m -jar /home/ubuntu/revx-exec-c/app.jar --revx-park --revx.exec.bot-id=c --revx.exec.symbol=ETH/USDC --revx.exec.journal=state/exec-c-eth.db || true'

SuccessExitStatus=143
Restart=no
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
