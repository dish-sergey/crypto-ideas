[Unit]
Description=Revolut X — СВОДНЫЙ бот (только чтение журналов шести исполнителей)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/revx-info
EnvironmentFile=/etc/revx-info.env

# Сводка по всем исполнителям в одном чате (06.09.2026).
#
# С шестью ботами обход каждого по очереди перестал быть практичным. Свести их
# внутрь любого из шести нельзя: исполнитель знает только свой журнал, а лезть
# в чужие журналы боту, который в это время торгует, значит добавить ему
# блокировок на горячем пути ради отчёта.
#
# ⚠️ ТОКЕН СВОЙ, СЕДЬМОЙ. Два потребителя getUpdates на одном токене дают 409 и
# молча отбирают управление друг у друга — это уже ловили на S5.
#
# ⚠️ ТОРГОВОГО КЛЮЧА ЗДЕСЬ НЕТ И БЫТЬ НЕ ДОЛЖНО. Сводка ничего не может сделать
# со счётом по построению: она открывает журналы через ExecJournal.readOnly
# (mode=ro, ни DDL, ни PRAGMA) и не умеет ни включать котирование, ни трогать
# заявки. Управление осталось у каждого исполнителя намеренно — команда «стоп»,
# отданная не тому боту, самая дорогая ошибка интерфейса, какая тут возможна.
#
# Отсюда же следует, что /etc/revx-info.env содержит ТОЛЬКО токен и chat_id.
ExecStart=/home/ubuntu/jre25/bin/java -Xms32m -Xmx160m -jar /home/ubuntu/revx-info/app.jar --revx-info

# Перезапуск РАЗРЕШЁН, в отличие от исполнителей: сводка ничем не рискует, а
# молчащий монитор хуже отсутствующего — на него перестают смотреть, но
# продолжают на него полагаться.
Restart=on-failure
RestartSec=30
SuccessExitStatus=143
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
