[Unit]
# Микро-live Revolut X: РЕАЛЬНЫЕ ордера минимального размера.
#
# Зависит от сбора: справедливая цена читается из базы стенда. Если сбор стоит,
# исполнитель это увидит сам (данные устарели) и снимет заявки — но запускать
# его раньше сбора незачем.
Description=Revolut X micro-live BOT A (REAL orders) — BTC/USDC
After=network-online.target revx-collect.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/revx-exec

# Торговый ключ и токен бота — только отсюда, root-owned 600 (ТЗ §6).
# В конфиге приложения и в репозитории их нет и быть не должно.
EnvironmentFile=/etc/revx-exec.env

# Профиль A — BTC/USDC, ШЕСТАЯ (последняя) по доходу пара набора (06.09.2026).
#
# Чем был раньше: сначала контролем без механизмов, потом ступенью лестницы
# отступа, потом носителем сетки 7/9/11. Все эти роли мерили НАСТРОЙКУ на одной
# паре. С 06.09.2026 шесть ботов мерят ВЫБОР ПАРЫ, и биткойн в этом наборе —
# не фаворит, а точка отсчёта: единственная пара, где мы уже знаем, как ведёт
# себя живое исполнение (сходимость повтора 99.92%).
#
# ⚠️ ОТСТУП 10, А НЕ ИЗМЕРЕННЫЙ ОПТИМУМ 8. Обход даёт 8 → +2.6866 при 311
# постановках в сутки, 10 → +2.6721. Полпроцента дохода стоят трети всего
# суточного бюджета аккаунта. Пока пар было три, за это стоило платить; при
# шести — нет: биткойн худший расходник набора, доход на постановку +0.00054
# против +0.0059 у ENA, то есть в одиннадцать раз меньше.
#
# Дальше расширять нельзя: 12 → +2.2322 (−17%), 14 → +1.7633, 20 → +0.5527.
# Пик у BTC узкий, в отличие от тонких пар, где доход растёт до 20 б.п. и выше.
#
# ⚠️ Расход на 10 б.п. — экстраполяция по закону прихода (κ ≈ 0.3…0.45 на б.п.),
# а не измерение: обход печатал постановки только для лучшей ступени. Ждём
# около 160 в сутки при доле 300. Первая живая неделя это уточнит.
#
# ⚠️ ОКНО ИЗМЕРЕНИЯ ДЛЯ БИТКОЙНА БЫЛО ЩЕДРЫМ, сильнее, чем для остальных пяти.
# Дней с движением ≥5% в окне 18.8% при базовой частоте 3.9% за два года —
# впятеро чаще нормы. А 16-дневная доходность +14.9% попала в 94-й перцентиль
# всех двухнедельных отрезков. «Реализовано» считается по закрытым парам FIFO,
# непроданный остаток в него не входит, и на растущем рынке это льстит.
#
# Механизмы выключены ЯВНО, а не умолчанием: умолчание меняется правкой конфига,
# и профиль однажды перестанет быть тем, чем задуман, молча.
ExecStart=/home/ubuntu/jre25/bin/java -Xms32m -Xmx192m -jar /home/ubuntu/revx-exec/app.jar --revx-exec \
  --revx.exec.bot-id=a \
  --revx.exec.symbol=BTC/USDC \
  --revx.exec.journal=state/exec.db \
  --revx.exec.size=0.00003765 \
  --revx.exec.inventory-cap=0.00025097 \
  --revx.exec.offset=0.0012 \
  --revx.exec.skew-target=0.3 \
  --revx.exec.cost-floor-margin=-1 \
  --revx.exec.anchor-leash=-1 \
  --revx.exec.own-position=true \
  --revx.exec.park-distance=0.10 \
  --revx.exec.levels=1 \
  --revx.exec.level-step=0.0002 \
  --revx.exec.inner-first=false

# Размеры под цену BTC 79 691.64 на 06.09.2026: лот $1 = 0.00001255 BTC,
# потолок $20 = 0.00025097 BTC (прежде было $20 при лоте $1 — не изменилось,
# пересчитано под текущую цену). Шаг количества 1e-08, шаг цены 0.01 =
# 0.0013 б.п. — сетка любой частоты сюда укладывается.
#
# ⚠️ Журнал ПРЕЖНИЙ (state/exec.db): пара не менялась, и разрывать историю
# биткойна незачем. У ботов, сменивших пару, журнал новый — FIFO нельзя
# заставить складывать разные монеты в одну позицию.

# Аварийная остановка при выключении сервиса: заявки на бирже переживают наш
# процесс, и оставлять их там нельзя. Хук в приложении снимает их сам, но если
# оно не успело — добиваем отдельной командой. Только СВОИ заявки: panic-all по
# умолчанию false, иначе остановка A снимала бы заявки пяти остальных.
# ПЛАНОВАЯ остановка ПАРКУЕТ заявки, а не снимает их: восстановление после# отмены стоит 3-6 постановок (замер 07.09.2026), а оставленную заявку# вернувшийся бот усыновляет по метке и двигает через PUT — бесплатно.# ⚠️ Аварийная остановка по-прежнему снимает всё: --revx-panic на кнопке в боте# и на ручном запуске (ТЗ §6). Трогает ТОЛЬКО свои заявки.
ExecStopPost=/bin/bash -c '/home/ubuntu/jre25/bin/java -Xmx192m -jar /home/ubuntu/revx-exec/app.jar --revx-park --revx.exec.bot-id=a --revx.exec.symbol=BTC/USDC --revx.exec.journal=state/exec.db || true'

# ⚠️ Restart=no НАМЕРЕННО. Перезапуск после падения не должен сам возобновлять
# торговлю: сначала человек смотрит, почему упало. Котирование в любом случае
# стартует ВЫКЛЮЧЕННЫМ и включается только командой /start в Telegram.
# Нормальная остановка через SIGTERM даёт код 143. Без этой строки systemd
# показывает «failed» после каждого штатного stop, и настоящую аварию в этом шуме
# уже не заметить.
SuccessExitStatus=143
Restart=no
TimeoutStopSec=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
