[Unit]
# Микро-live Revolut X: РЕАЛЬНЫЕ ордера минимального размера.
#
# Зависит от сбора: справедливая цена читается из базы стенда. Если сбор стоит,
# исполнитель это увидит сам (данные устарели) и снимет заявки — но запускать
# его раньше сбора незачем.
Description=Revolut X micro-live executor (REAL orders, micro size)
After=network-online.target revx-collect.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/revx-exec

# Торговый ключ и токен бота — только отсюда, root-owned 600 (ТЗ §6).
# В конфиге приложения и в репозитории их нет и быть не должно.
EnvironmentFile=/etc/revx-exec.env

# Профиль A — ТОРГУЮЩИЙ КОНТРОЛЬ (док. 128 §3).
#
# Раньше A стоял на значениях по умолчанию, то есть с целью инвентаря 0. За
# первое чистое окно это дало **7.6% двусторонних котировок**: 92% времени он был
# не маркет-мейкером, а программой лимитных покупок. Сравнение A против B тогда
# меряет «даёт ли наличие инвентаря котировать двусторонне» — тавтологию, потому
# что цель 0.3 ровно на это и настроена. И главное: у бота без инвентаря ни полу
# по себестоимости, ни поводку не на чем сработать, значит этим окном они не
# проверены ВОВСЕ.
#
# Поэтому цель инвентаря у обоих одна, а различие — ровно в механизмах:
#   A: цель 0.3, пол и поводок ВЫКЛЮЧЕНЫ
#   B: цель 0.3 + пол + поводок (см. revx-exec-b.service)
#
# ⚠️ С 06.09.2026 A ведёт СЕТКУ 7/9/11 б.п. (три уровня шагом 2, заполнение от
# дальнего). Измерено на 8.6 сутках BTC при капитале $20:
#
#   один уровень 7 б.п., лот $1   +0.0791   161 постановка/сут
#   один уровень 7 б.п., лот $2   +0.3863   120
#   СЕТКА 7/9/11 от дальнего      +0.5310   253
#   три отдельных бота 7/9/11     +0.5719   251
#
# Раздельные боты дают на 7% больше, но требуют трёх процессов и трёх меток, а
# в день обвала 28.08 оказались ХУЖЕ сетки (−0.2585 против −0.2299). Сетка не
# была худшей ни в одном из пяти режимов — растущем, падающем, спокойном,
# обвальном и ралли.
#
# Базовый отступ 7 б.п. лучший из проверенных: 5/7/9 даёт +0.32 при вдвое
# большем расходе постановок и худшем обвале, 8/10/12 даёт +0.48, 10/12/14 —
# +0.37 (но втрое эффективнее по расходу лимита, туда уходить, если лимит
# станет узким).
#
# Заполнение ОТ ДАЛЬНЕГО: по рабочей модели ничья с «от ближнего» (+0.5310
# против +0.5347), по верхней границе заметно лучше (+0.5889 против +0.5565),
# и постановок тратит на 9% меньше.
#
# ⚠️ Лот остаётся $1. Сетка с лотом $2 измерена и УБЫТОЧНА: +0.1013 по рабочей
# модели и −0.0979 по верхней. Отношение потолка к лоту падает ниже семи
# ступеней, и бот подолгу стоит на нуле или в потолке.
# Тогда разница изолирует добавленный механизм, и оба бота торгуют.
#
# Выключенное состояние задаётся явно, а не умолчанием: умолчание меняется
# правкой конфига, и контроль однажды перестанет быть контролем молча.
ExecStart=/home/ubuntu/jre25/bin/java -Xms32m -Xmx192m -jar /home/ubuntu/revx-exec/app.jar --revx-exec \
  --revx.exec.bot-id=a \
  --revx.exec.skew-target=0.3 \
  --revx.exec.cost-floor-margin=-1 \
  --revx.exec.anchor-leash=-1 \
  --revx.exec.own-position=true \
  --revx.exec.park-distance=0.10 \
  --revx.exec.offset=0.0007 \
  --revx.exec.levels=3 \
  --revx.exec.level-step=0.0002 \
  --revx.exec.inner-first=false

# Аварийная остановка при выключении сервиса: заявки на бирже переживают наш
# процесс, и оставлять их там нельзя. Хук в приложении снимает их сам, но если
# оно не успело — добиваем отдельной командой.
ExecStopPost=/bin/bash -c '/home/ubuntu/jre25/bin/java -Xmx192m -jar /home/ubuntu/revx-exec/app.jar --revx-panic || true'

# ⚠️ Restart=no НАМЕРЕННО. Перезапуск после падения не должен сам возобновлять
# торговлю: сначала человек смотрит, почему упало. Котирование в любом случае
# стартует ВЫКЛЮЧЕННЫМ и включается только командой /start в Telegram.
# Нормальная остановка через SIGTERM даёт код 143. Без этой строки systemd
# показывает «failed» после каждого штатного stop, и настоящую аварию в этом шуме
# уже не заметить.
SuccessExitStatus=143

Restart=no

TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
