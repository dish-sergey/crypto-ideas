# Скопируй в .env и заполни. Нужен ТОЛЬКО для бэкапов (профиль backup).
# Локальный smoke-test приложения (docker compose up) .env не требует.

# Cloudflare R2 → создать бакет и S3 API-токен в дашборде R2:
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=crypto-ideas-backup
LITESTREAM_ACCESS_KEY_ID=<r2-access-key-id>
LITESTREAM_SECRET_ACCESS_KEY=<r2-secret-access-key>
