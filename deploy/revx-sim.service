[Unit]
Description=Revolut X — СБОР ДЛЯ СИМУЛЯЦИИ: 5 пар, секунда, 50 уровней (ключ второго аккаунта)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/revx

# ЗАЧЕМ ЭТО И ПОЧЕМУ ЗДЕСЬ
#
# Данные по торгуемым BTC, ETH и SOL уже на практическом потолке: снимок раз в
# секунду (замерено 998 мс), 50 уровней, перекос ног 1–11 мс, лаг от отметки
# площадки 8 мс. Дальше только подсекундный шаг, а он не влезает в бюджет: наш
# аккаунт тратит ~790 запросов в минуту, и залпы 429 начинаются уже там.
#
# 🔑 Лимит у площадки общий НА АККАУНТ, а не на ключ («Each API key directly maps
# to the user account»). Поэтому ключ ДРУГОГО аккаунта — это вторая тысяча в
# минуту, не конкурирующая с торговлей. Он лежит в ~/revx/keys/ и выпущен только
# на чтение.
#
# ⚠️ Прежнее правило «ключей на micro2 нет и быть не должно» (SERVERS.md) писалось
# про НАШ ключ: он ходил бы в ту же тысячу, что и боты, и смысл второй машины
# пропал бы. К чужому аккаунту это не относится — наоборот, в нём весь смысл.
#
# ВЫБОР ПАР. Скрининг 14.09.2026 по сделкам НАШЕГО размера (а не по их числу:
# тринадцать пар дают ~620 принтов в сутки, но это пыль по 10–30 центов — у TON
# из 612 сделок больше доллара всего ТРИ). Сделок от $1 в сутки и спред:
#   XRP  414 ($509 средняя, 20.5 б.п.) — поток как у ETH, ни разу не торговали
#   ADA  125 ($244, 38.2)
#   SUI  107 ($268, 65.3)
#   LINK  87 ($282, 12.5) — спред самый узкий после BTC
#   DOGE  38 ($180, 14.1)
#
# РАСКЛАД НАГРУЗКИ. 5 пар = 10 ног (X/USDC и X/USD: вторая нужна для курса):
#   книги   10 ног / 1 с       = 600/мин
#   сделки   5 пар / 15 с      =  20/мин
#   ИТОГО ≈ 620/мин при лимите 1000, то есть 62%.
#
# ⚠️ ПОТОЛОК В СЕКУНДУ ПРИШЛОСЬ ПОДНЯТЬ. По умолчанию приложение держит 10 req/s,
# и десять ног раз в секунду дают ровно 10.08 — сборщик честно ВЫКЛЮЧИЛ быстрый
# ярус, чтобы не ловить 429 по всей вселенной. Площадка разрешает 100/с, а
# связывает нас тысяча в минуту (16.7/с в среднем), поэтому 12/с здесь безопасно:
# план 620/мин, то есть 62% минутного лимита.
#
# ⚠️ И ЁМКОСТЬ ВЕДРА: 12, а не 4. Десять ног встают в очередь ОДНОВРЕМЕННО, и при
# ёмкости 4 остальные шесть ждут по 83 мс каждая — цикл растягивался до 1568 мс
# вместо 1000 (замерено 14.09.2026). Площадка разрешает 100 запросов в секунду,
# так что залп в двенадцать для неё пустяк; связывает нас минутный лимит, а он
# от ёмкости ведра не зависит.
# Семь пар по секунде дали бы 87%, а на своём аккаунте мы ловим 429 уже при 79% —
# документированная тысяча режется раньше. Поэтому пять, а не семь.
#
# ⚠️ ОТДЕЛЬНЫЙ ФАЙЛ БАЗЫ. Старый revx.db на этой машине набит публичным сбором
# (раз в минуту, пять уровней, перекос ног 1250 мс). Смешивать его с секундными
# глубокими снимками нельзя: это ровно та ловушка «плотность сменилась, окна
# несравнимы», на которой мы уже обжигались 07.09.
#
# ⚠️ ДАННЫЕ ОТСЮДА — ТОЛЬКО ДЛЯ СИМУЛЯЦИИ. Живой бот читает справедливую цену из
# ЛОКАЛЬНОЙ базы на bot-arm; чтобы какой-то из этих пар торговать, её сбор
# придётся переносить туда (+120 запросов/мин), и это ровно тот запас, который
# нужен для новых ботов. Одновременно ARM не потянет.
Environment=JAVA_TOOL_OPTIONS=-Xms64m -Xmx320m
ExecStart=/home/ubuntu/jre25/bin/java -jar /home/ubuntu/revx/app.jar --revx-collect \
  --revx.db-path=data/revx-sim.db \
  --revx.collect-only=XRP,LINK,ADA,SUI,DOGE \
  --revx.fast-pairs=XRP,LINK,ADA,SUI,DOGE \
  --revx.fast-book-period-ms=1000 \
  --revx.tier1=XRP,LINK,ADA,SUI,DOGE \
  --revx.tier2= \
  --revx.trades-period-tier1-seconds=15 \
  --revx.trades-period-other-seconds=900 \
  --revx.book-depth-deep=50 \
  --revx.rate-book-period-seconds=0 \
  --revx.auth.required=true \
  --revx.auth.max-requests-per-second=12 \
  --revx.auth.burst-capacity=12

# ⚠️ auth.required=true — ГЛАВНЫЙ предохранитель этой машины. Без ключа
# приложение молча уходит на публичный путь: раз в секунду там не пустят, а
# глубина схлопнется до пяти уровней. Данные при этом идут, таблицы растут,
# никто не кричит — и обнаруживается это через неделю по странным числам.
# Теперь «ключа нет» или «ключ не принят» — причина НЕ ЗАПУСКАТЬСЯ, и systemd
# показывает failed. Проверка идёт по ГЛУБИНЕ ответа: публичный путь игнорирует
# limit и отдаёт пять уровней при любом запросе.
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=30
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
