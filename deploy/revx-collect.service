[Unit]
# Сбор данных стенда Revolut X (ТЗ — docs/63-...). Данные книги невосполнимы
# задним числом, поэтому сервис enabled и переживает ребут.
Description=Revolut X market-making stand: order book + trades collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/revx
# Куча маленькая: коллектор упирается в лимит площадки (~1 req/s), а не в CPU/RAM
# Мемкоины (не в корзине курса) — книга раз в 120 с: 28.09.2026 GET аккаунта упирался в 429.
ExecStart=/home/ubuntu/jre25/bin/java -Xms32m -Xmx160m -Drevx.auth.book-period-seconds=15 -Drevx.book-depth-deep=50 -Drevx.tier1=ETH,BTC,SOL -Drevx.tier2=BNB,AVAX,LINK,XRP,SUI -Drevx.trades-period-tier1-seconds=15 -Drevx.meme-book-period-seconds=120 -Drevx.fast-pairs=BTC,SOL,XRP -Drevx.auth.max-requests-per-second=12 -Drevx.auth.burst-capacity=8 -jar /home/ubuntu/revx/app.jar --revx-collect
Restart=always
RestartSec=15
# SIGTERM демон обрабатывает сам (shutdown hook): дописывает healthcheck и закрывает БД
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=revx-collect

[Install]
WantedBy=multi-user.target
